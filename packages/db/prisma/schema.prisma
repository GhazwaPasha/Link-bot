generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum FormStatus {
  DRAFT
  PUBLISHED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum IntegrationType {
  SHEETS
  WEBHOOK
}

enum PanelButtonStyle {
  PRIMARY
  SECONDARY
  SUCCESS
  DANGER
}

model Guild {
  guildId       String   @id @map("guild_id")
  name          String?
  iconUrl       String?  @map("icon_url")
  reviewRoleIds String[] @default([]) @map("review_role_ids")
  joinedAt      DateTime @default(now()) @map("joined_at")
  leftAt        DateTime? @map("left_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  forms        Form[]
  panels       Panel[]
  submissions  Submission[]
  integrations Integration[]

  @@map("guilds")
}

model Form {
  id              String     @id @default(cuid())
  guildId         String     @map("guild_id")
  name            String
  description     String?
  fields          Json       @default("[]")
  status          FormStatus @default(DRAFT)
  reviewChannelId String?    @map("review_channel_id")
  outputChannelId String?    @map("output_channel_id")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  guild        Guild         @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  panelButtons PanelButton[]
  submissions  Submission[]
  integrations Integration[]

  @@index([guildId])
  @@map("forms")
}

model Panel {
  id            String   @id @default(cuid())
  guildId       String   @map("guild_id")
  name          String
  description   String?
  postChannelId String   @map("post_channel_id")
  messageId     String?  @map("message_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  guild   Guild         @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  buttons PanelButton[]

  @@index([guildId])
  @@map("panels")
}

model PanelButton {
  id        String           @id @default(cuid())
  panelId   String           @map("panel_id")
  formId    String           @map("form_id")
  label     String
  style     PanelButtonStyle @default(PRIMARY)
  emoji     String?
  sortOrder Int              @default(0) @map("sort_order")
  createdAt DateTime         @default(now()) @map("created_at")

  panel Panel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  form  Form  @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([panelId])
  @@index([formId])
  @@map("panel_buttons")
}

model Submission {
  id              String           @id @default(cuid())
  formId          String           @map("form_id")
  guildId         String           @map("guild_id")
  userId          String           @map("user_id")
  answers         Json             @default("{}")
  status          SubmissionStatus @default(PENDING)
  reviewChannelId String?          @map("review_channel_id")
  reviewMessageId String?          @map("review_message_id")
  outputChannelId String?          @map("output_channel_id")
  reviewedBy      String?          @map("reviewed_by")
  reviewedAt      DateTime?        @map("reviewed_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  form  Form  @relation(fields: [formId], references: [id], onDelete: Cascade)
  guild Guild @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([formId])
  @@index([guildId])
  @@map("submissions")
}

model Integration {
  id        String          @id @default(cuid())
  guildId   String          @map("guild_id")
  formId    String          @map("form_id")
  type      IntegrationType
  config    Json            @default("{}")
  enabled   Boolean         @default(true)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  guild Guild @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  form  Form  @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@index([formId])
  @@map("integrations")
}
