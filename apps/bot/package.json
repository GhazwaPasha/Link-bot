{
  "name": "@discord-forms/bot",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "pnpm --filter @discord-forms/db run build && pnpm --filter @discord-forms/shared run build && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "register-commands": "tsx src/registerCommands.ts"
  },
  "dependencies": {
    "@discord-forms/db": "workspace:*",
    "@discord-forms/shared": "workspace:*",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.4",
    "google-auth-library": "^9.14.1",
    "googleapis": "^144.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.0"
  }
}
